# ============ 服务配置 ============
PORT=3000
NODE_ENV=development

# ============ 大模型配置 ============
# 模型提供商：siliconflow（硅基流动）或 deepseek
LLM_PROVIDER=siliconflow

# API 密钥（留空则自动启用 Mock 模式，无需 Key 也能完整演示流程）
LLM_API_KEY=

# 模型名称
#   硅基流动常用：Qwen/Qwen2.5-72B-Instruct、deepseek-ai/DeepSeek-V3、THUDM/glm-4-9b-chat
#   DeepSeek 常用：deepseek-chat、deepseek-reasoner
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# 自定义接口地址（留空则使用所选提供商的默认地址）
#   硅基流动：https://api.siliconflow.cn/v1
#   DeepSeek：https://api.deepseek.com/v1
LLM_BASE_URL=

# 生成参数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ============ JWT 配置 ============
JWT_SECRET=change_this_to_a_random_string_in_production
JWT_EXPIRES_IN=7d

# ============ MySQL 数据库配置 ============
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=travel_ai

# ============ 前端地址（CORS 白名单，多个用逗号分隔）============
CORS_ORIGIN=http://localhost:5173
