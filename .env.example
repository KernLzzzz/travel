# ============================================================
#  容器化部署环境变量模板
#
#  用法：cp .env.example .env，然后按需修改
#  本文件会被提交到 Git（不含任何真实密钥）；.env 已被 .gitignore 忽略
# ============================================================

# ---------------- 端口映射 ----------------
# 前端对外端口，浏览器访问 http://localhost:<该端口>
FRONTEND_HOST_PORT=80
# MySQL 主机端口，默认 3307 以避开本机已装的 MySQL
MYSQL_HOST_PORT=3307
# 需要直连后端调试时，把 docker-compose.yml 里 backend.ports 的注释打开
# BACKEND_HOST_PORT=3000

# ---------------- MySQL ----------------
MYSQL_ROOT_PASSWORD=travel_ai_root_pwd
MYSQL_DATABASE=travel_ai
MYSQL_USER=travel
MYSQL_PASSWORD=travel_ai_pwd

# ---------------- 安全 ----------------
# 生产环境务必替换为高强度随机串，例如：
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------------- 大模型 ----------------
# 留空则后端自动进入 Mock 模式：不调用真实模型，但全部业务流程可完整演示
LLM_PROVIDER=siliconflow
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
LLM_BASE_URL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# 其它可选直连方式（已注释，按需启用其一）
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_MODEL=deepseek-chat

# ---------------- AI 网关调优 ----------------
# 同时最多允许多少个模型调用
AI_MAX_CONCURRENCY=5
# 单次调用总时长上限（毫秒）
AI_TIMEOUT_MS=120000
# 单个数据块最长等待时间（毫秒），超过视为模型卡住
AI_STALL_MS=30000
# 限流令牌桶容量
AI_RATE_CAPACITY=10
# 每秒补充的令牌数（0.1667 约等于 6 秒恢复 1 次额度）
AI_RATE_REFILL=0.1667
# 结果缓存条目上限
AI_CACHE_MAX=100
# 结果缓存有效期（毫秒）
AI_CACHE_TTL_MS=600000

# ---------------- 跨域 ----------------
# 容器内由 Nginx 同源代理，一般无需修改
CORS_ORIGIN=http://localhost
